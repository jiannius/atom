{
    "name": "jiannius/atom",
    "description": "Atom UI components",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "intervention/image": "^3.0",
        "livewire/livewire": "^4.0",
        "ueberdosis/tiptap-php": "^2.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jiannius\\Atom\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Atom\\Tests\\": "tests/",
            "App\\Actions\\": "tests/Fixtures/Actions/"
        }
    },
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Atom\\AtomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": false,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
