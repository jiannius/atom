# Keep dev-only files out of the archive Composer installs from (dist, vendor-installed package).
# Never list anything a host needs at runtime: dist/, components/, resources/, src/, routes/, lang/, json/.
/.github export-ignore
/docs export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/phpunit.xml export-ignore
/playwright.config.js export-ignore
/testbench.yaml export-ignore
